//-----------------------------------------------------------------------------
//	SOURCEVR_DISPLAY.VPC
//
//	The engine's VR module (sourcevr) for stereoscopic displays: 3D TVs,
//	projectors and monitors. Linux and Windows; the gamescope outputs
//	(anaglyph, rows, checkerboard) are Linux only, as gamescope is.
//-----------------------------------------------------------------------------

$Macro SRCDIR		".."
$Macro OUTBINDIR	"$SRCDIR\..\game\bin"
$Macro OUTBINNAME	"sourcevr"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"$BASE,$SRCDIR\public\sourcevr"
	}
}

$Project "sourcevr_display"
{
	$Folder	"Source Files"
	{
		$File	"sourcevr_display.cpp"
		$File	"stereo_shot.cpp"
	}

	$Folder	"Header Files"
	{
		$File	"$SRCDIR\public\sourcevr\isourcevirtualreality.h"
		$File	"$SRCDIR\public\sourcevr\isourcevrdisplay.h"
		$File	"stereo_shot.h"
		$File	"$SRCDIR\thirdparty\stb\stb_image_write.h"
	}

	$Folder	"Link Libraries"
	{
		$Lib mathlib
		$Lib tier1
	}
}
